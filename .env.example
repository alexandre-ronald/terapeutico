DEBUG=1
SECRET_KEY=replace-with-a-local-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:9500

POSTGRES_DB=terapeutico
POSTGRES_USER=terapeutico
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

AUTH_LDAP_SERVER_URI=ldap://ldap.example.local:389
AUTH_LDAP_SEARCH_BASE=DC=example,DC=local
AUTH_LDAP_DOMAIN=example
AUTH_LDAP_ADMIN_GROUP=CN=DjangoAdmins,OU=Groups,DC=example,DC=local

SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
CSRF_COOKIE_HTTPONLY=1
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

JWT_SECRET_KEY=replace-with-a-different-local-key
JWT_EXPIRATION_SECONDS=60
